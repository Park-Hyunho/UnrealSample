# ── Unreal 생성물 (다시 만들어짐) ──
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# 빌드 산출물 (PakBlacklist · 아이콘은 유지)
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# 맵 라이트 빌드 데이터 (에디터에서 다시 빌드)
*_BuiltData.uasset

# ── IDE / 빌드 파일 ──
.vs/
.vscode/
.idea/
.vsconfig
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
.ignore

# ── C++ 컴파일 결과 (C++ 모듈을 추가할 때 대비) ──
# *.obj 는 3D 메시 원본(LFS)과 겹쳐 제외 — 컴파일 .obj 는 Intermediate/ 에 생김
*.o
*.lib
*.dll
*.exe
*.pdb
*.gch
*.pch

# ── OS ──
Thumbs.db
Desktop.ini
.DS_Store

# ── 기타 ──
*.log
